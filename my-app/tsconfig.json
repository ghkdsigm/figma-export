{
  "compilerOptions": {
    "target": "ES2020",         // Node 18 이상이면 ES2020 이상 추천
    "module": "ESNext",         // 여기 중요! ESNext 또는 Node16/Node18 권장
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true
  }
}
